# Copy to apps/web/.env.local (or run `pnpm setup:env` from the repo root).

# Where the API runs. The console proxies /api/* to it, so the browser only
# ever talks to the console's own origin.
API_URL=http://localhost:4000

# Each company's console is at <slug>.<APP_BASE_DOMAIN>, e.g.
# http://demo.localhost:3000. Must match APP_BASE_DOMAIN in apps/api/.env.
APP_BASE_DOMAIN=localhost

# The lender's public website (apps/site), linked from the sign-in pages and
# the borrower portal. Optional.
SITE_URL=http://localhost:3001

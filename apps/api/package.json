{
  "name": "@kora/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint src prisma test",
    "test": "prisma generate && vitest run",
    "test:e2e": "prisma generate && vitest run --config vitest.e2e.config.mts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && node ../../scripts/reporting-role.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@kora/core": "workspace:*",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.5.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^6.7.6",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "multer": "^2.5.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.5.0",
    "@swc/core": "^1.15.18",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^5.1.0"
  }
}

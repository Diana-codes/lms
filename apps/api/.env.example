# Copy to apps/api/.env (or run `pnpm setup:env` from the repo root, which
# also generates the secrets). Never commit the real file.

NODE_ENV=development
PORT=4000

# Local Postgres and Redis from docker-compose.yml (host ports 5433 / 6380).
# DATABASE_URL is the owner login: migrations, the seed and the platform admin.
DATABASE_URL=postgresql://kora:kora_dev_only@localhost:5433/kora_lend?schema=public
# The login the API uses for company data. It owns nothing, so row-level
# security applies to it. `pnpm setup:env` fills in a password; `pnpm db:migrate`
# creates the login.
APP_DATABASE_URL=
REDIS_URL=redis://localhost:6380

# Where the console runs. Used for CORS.
WEB_ORIGIN=http://localhost:3000
# The one company this system serves: Bridge to Finance.
COMPANY_SLUG=bf
# Multi-company hosting (companies by subdomain of APP_BASE_DOMAIN, and the
# platform admin) is switched off. Leave these as they are.
# MULTI_COMPANY=true
APP_BASE_DOMAIN=localhost

# 32+ random bytes each. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
# 32 bytes, base64. Encrypts national IDs and 2FA secrets at rest.
# Generate with: openssl rand -base64 32
PII_ENCRYPTION_KEY=
# 32+ random bytes. Keys the HMAC used to de-duplicate national IDs.
PII_HASH_KEY=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Set to true behind HTTPS (always in production).
COOKIE_SECURE=false

# Password given to every seeded staff account. Development only.
SEED_STAFF_PASSWORD=

# ── Phase 2: payments and SMS (leave empty to use the local simulator) ──
# MTN MoMo sandbox: the "Primary key" of each product subscription
# (momodeveloper.mtn.com → your profile → Subscriptions). 32 characters each.
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=

# The demo company's own Africa's Talking account, for reminders and other
# messages to borrowers (the seed copies it into the company's settings; each
# company's keys are set by a platform admin). Sandbox: the username is the
# word "sandbox"; the API key comes from the sandbox app's Settings → API Key.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=

# ── Sign-in codes by SMS ──
# The platform's own Africa's Talking account (Orin Tech House) sends every
# sign-in code, for staff and platform admins. Required in production. Leave
# the key empty in development to use the simulator: codes then appear in the
# API log. With username "sandbox", texts go to the Africa's Talking simulator
# (developers.africastalking.com → Sandbox → Launch simulator).
PLATFORM_SMS_USERNAME=sandbox
PLATFORM_SMS_API_KEY=
# Your registered sender ID or short code, once you have one.
PLATFORM_SMS_SENDER_ID=
# Development only: the simulator also writes each text here (the browser tests
# read sign-in codes from it). Must be empty in production.
SMS_OUTBOX_FILE=.sms-outbox.log

# ── Phase 5: scoring and AI ──
# The scoring service in services/ml.
ML_URL=http://localhost:8000
# Claude, for summaries, collections advice, SMS drafts and "Ask your data".
# Leave empty to switch those features off; scoring still works without it.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# A read-only login that can only see the reporting views. `pnpm setup:env`
# fills in a password; `pnpm db:migrate` creates the login.
REPORTING_DATABASE_URL=

# A long random string in webhook URLs (MoMo callbacks, SMS delivery reports).
WEBHOOK_TOKEN=
# Your public https address, so MTN can call back. Optional: payments are also polled.
PUBLIC_API_URL=
# Your MoMo Pay merchant code, quoted in reminder SMS once you have it.
MOMO_PAY_CODE=

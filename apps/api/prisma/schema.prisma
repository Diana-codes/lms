// Kora Lend data model.
//
// Rules this schema enforces (BUILD_BRIEF §4):
//  - Money is whole RWF in BigInt columns. There are no Float or Decimal money fields.
//  - Balances are never stored on a loan. They are sums over LedgerEntry.
//  - LedgerEntry, LedgerTransaction and AuditLog are append-only, and every
//    ledger transaction must balance. Both are enforced by triggers in the
//    first migration, not only by application code.
//  - Payment and Disbursement carry unique idempotency keys and external refs.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Platform and companies ─────────────────────────
//
// Kora Lend is multi-tenant. Every business record carries a companyId, and
// Postgres row-level security (see the multi_tenancy migration) only lets the
// API's database login see rows of the company set for the current request.
// companyId defaults to current_company_id(), so inserts are filled in by the
// database from that same setting.

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

/// A lending company using the platform.
model Company {
  id              String        @id @default(uuid(7)) @db.Uuid
  /// Subdomain, e.g. "bf" for bf.koralend.rw. Lowercase letters, digits and hyphens.
  slug            String        @unique
  name            String
  legalName       String?
  status          CompanyStatus @default(ACTIVE)
  country         String        @default("RW")
  currency        String        @default("RWF")
  timezone        String        @default("Africa/Kigali")
  defaultLanguage Language      @default(EN)

  /// Where borrowers ask questions and complain (on the Key Facts Statement).
  supportPhone String?
  supportEmail String?
  address      String?

  /// Branding shown in the console and on borrower-facing pages.
  brandName   String?
  brandColor  String?
  accentColor String?
  logoUrl     String?

  /// Optional features, off unless the company turns them on.
  aiFeatures  Boolean @default(false)
  autoApprove Boolean @default(false)

  /// HMAC of the secret in this company's provider webhook URLs.
  webhookTokenHash String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches           Branch[]
  users              User[]
  sessions           Session[]
  borrowers          Borrower[]
  businesses         Business[]
  kycDocuments       KycDocument[]
  consents           Consent[]
  products           Product[]
  productVersions    ProductVersion[]
  applications       Application[]
  creditScores       CreditScore[]
  loans              Loan[]
  instalments        ScheduleInstalment[]
  ledgerAccounts     LedgerAccount[]
  ledgerTransactions LedgerTransaction[]
  ledgerEntries      LedgerEntry[]
  payments           Payment[]
  disbursements      Disbursement[]
  restructures       Restructure[]
  collectionCases    CollectionCase[]
  contactLogs        ContactLog[]
  promises           PromiseToPay[]
  notes              Note[]
  notifications      Notification[]
  smsMessages        SmsMessage[]
  auditLogs          AuditLog[]
  codeCounters       CodeCounter[]
  credentials        ProviderCredential[]
  simulatedTransfers SimulatedTransfer[]
  otpChallenges      OtpChallenge[]
  staffCodes         StaffCode[]
  borrowerSessions   BorrowerSession[]
  offers             LoanOffer[]
  momoInflows        MomoInflowMonth[]
  dataQuestions      DataQuestion[]
  aiNotes            AiNote[]
  usage              CompanyUsageDaily[]
}

/// One day's usage figures for a company, recorded by the nightly job, for billing.
model CompanyUsageDaily {
  companyId      String   @default(dbgenerated("current_company_id()")) @db.Uuid
  company        Company  @relation(fields: [companyId], references: [id])
  day            DateTime @db.Date
  activeLoans    Int
  borrowers      Int
  activeStaff    Int
  loansDisbursed Int
  smsSent        Int
  recordedAt     DateTime @default(now())

  @@id([companyId, day])
}

/// Someone who runs the platform (Orin Tech House). Not part of any company,
/// and invisible to the API's company-scoped database login.
model PlatformAdmin {
  id               String    @id @default(uuid(7)) @db.Uuid
  email            String    @unique
  name             String
  passwordHash     String
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())

  /// TOTP secret, encrypted. Two-factor is required: until it is on, the
  /// admin can only set it up.
  totpSecretEnc String?
  totpEnabledAt DateTime?
  /// Last accepted TOTP time step, to stop a code being replayed.
  totpLastStep  Int?

  /// For sign-in codes by text, once verified.
  phone           String?
  phoneVerifiedAt DateTime?

  sessions PlatformSession[]
  codes    PlatformCode[]
}

enum CodePurpose {
  SIGN_IN
  VERIFY_PHONE
}

/// One-time codes texted to a platform admin. Only an HMAC of the code is kept.
model PlatformCode {
  id         String        @id @default(uuid(7)) @db.Uuid
  subjectId  String        @db.Uuid
  admin      PlatformAdmin @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  purpose    CodePurpose
  phone      String
  codeHash   String
  attempts   Int           @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([subjectId, createdAt])
}

model PlatformSession {
  id        String    @id @default(uuid(7)) @db.Uuid
  adminId   String    @db.Uuid
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

// ───────────────────────── Staff, roles, branches ─────────────────────────

/// Staff roles. The brief lists Role as an entity; a fixed enum keeps the
/// role guards type-safe. Move to a table if roles need to be edited at runtime.
enum StaffRole {
  ADMIN
  MANAGER
  LOAN_OFFICER
  COLLECTIONS_AGENT
}

model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @default(dbgenerated("current_company_id()")) @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  code      String
  name      String
  district  String
  createdAt DateTime @default(now())

  users        User[]
  borrowers    Borrower[]
  applications Application[]
  loans        Loan[]

  @@unique([companyId, code])
}

/// A member of staff who signs in to the lender console.
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  companyId    String    @default(dbgenerated("current_company_id()")) @db.Uuid
  company      Company   @relation(fields: [companyId], references: [id])
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         StaffRole
  branchId     String?   @db.Uuid
  phone        String?
  isActive     Boolean   @default(true)

  /// TOTP secret, AES-256-GCM encrypted. Null until 2FA setup starts.
  totpSecretEnc String?
  totpEnabledAt DateTime?
  /// Last accepted TOTP time step, to stop a code being replayed.
  totpLastStep  Int?

  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  /// Set when an administrator sets the password: the user must choose a
  /// new one before doing anything else.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  /// When the user proved `phone` receives texts. Sign-in codes are sent there
  /// unless they use an authenticator app. Cleared when the number changes.
  phoneVerifiedAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  branch   Branch?     @relation(fields: [branchId], references: [id])
  sessions Session[]
  codes    StaffCode[]

  borrowers            Borrower[]          @relation("BorrowerOfficer")
  applications         Application[]       @relation("ApplicationOfficer")
  decidedApplications  Application[]       @relation("ApplicationDecider")
  secondApprovals      Application[]       @relation("ApplicationSecondApprover")
  loans                Loan[]              @relation("LoanOfficer")
  scoreOverrides       CreditScore[]
  verifiedDocuments    KycDocument[]
  paymentsRecorded     Payment[]
  disbursementsStarted Disbursement[]      @relation("DisbursementInitiator")
  disbursementsOkayed  Disbursement[]      @relation("DisbursementApprover")
  restructuresAsked    Restructure[]       @relation("RestructureRequester")
  restructuresDecided  Restructure[]       @relation("RestructureApprover")
  collectionCases      CollectionCase[]
  contactLogs          ContactLog[]
  promisesRecorded     PromiseToPay[]
  notes                Note[]
  notifications        Notification[]
  smsSent              SmsMessage[]
  ledgerTransactions   LedgerTransaction[]

  /// Accounts are per company: the same email can be staff at two lenders.
  @@unique([companyId, email])
}

/// A refresh-token session. Only a hash of the token is stored.
model Session {
  id                   String    @id @default(uuid(7)) @db.Uuid
  companyId            String    @default(dbgenerated("current_company_id()")) @db.Uuid
  company              Company   @relation(fields: [companyId], references: [id])
  userId               String    @db.Uuid
  refreshTokenHash     String    @unique
  /// The token this one replaced. Accepted for a few seconds after rotation,
  /// so two requests racing to refresh do not sign the user out.
  prevRefreshTokenHash String?   @unique
  rotatedAt            DateTime?
  userAgent            String?
  ip                   String?
  createdAt            DateTime  @default(now())
  lastUsedAt           DateTime  @default(now())
  expiresAt            DateTime
  revokedAt            DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
}

// ───────────────────────── Borrowers and KYC ─────────────────────────

enum BorrowerType {
  INDIVIDUAL
  BUSINESS
}

enum Gender {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

enum Language {
  EN
  RW
  FR
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model Borrower {
  id        String       @id @default(uuid(7)) @db.Uuid
  companyId String       @default(dbgenerated("current_company_id()")) @db.Uuid
  company   Company      @relation(fields: [companyId], references: [id])
  /// Human reference, e.g. BR-00731.
  code      String
  type      BorrowerType @default(INDIVIDUAL)
  fullName  String
  /// E.164, e.g. +250788123412. Always mask before display or logging.
  /// Unique per company: the same person can borrow from two lenders.
  phone     String

  /// National ID, AES-256-GCM encrypted. Never stored in the clear.
  nationalIdEnc   String?
  /// HMAC of the ID, so duplicates can be found without decrypting.
  nationalIdHash  String?
  /// Last three digits, for the masked display.
  nationalIdLast3 String?

  dateOfBirth       DateTime? @db.Date
  gender            Gender    @default(UNDISCLOSED)
  preferredLanguage Language  @default(EN)
  district          String?
  sector            String?

  /// Verified monthly income or revenue, used by the affordability rule.
  monthlyIncome    BigInt?
  incomeVerifiedAt DateTime?
  momoLinked       Boolean    @default(false)
  kycStatus        KycStatus  @default(PENDING)
  riskLevel        RiskLevel?
  preApprovedLimit BigInt?

  officerId     String?  @db.Uuid
  branchId      String?  @db.Uuid
  customerSince DateTime @default(now()) @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  officer User?   @relation("BorrowerOfficer", fields: [officerId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])

  business      Business?
  kycDocuments  KycDocument[]
  consents      Consent[]
  applications  Application[]
  creditScores  CreditScore[]
  loans         Loan[]
  payments      Payment[]
  contactLogs   ContactLog[]
  notes         Note[]
  notifications Notification[]
  smsMessages   SmsMessage[]
  sessions      BorrowerSession[]
  offers        LoanOffer[]
  momoInflows   MomoInflowMonth[]

  @@unique([companyId, code])
  @@unique([companyId, phone])
  @@unique([companyId, nationalIdHash])
  @@index([fullName])
  @@index([officerId])
}

model Business {
  id                String    @id @default(uuid(7)) @db.Uuid
  companyId         String    @default(dbgenerated("current_company_id()")) @db.Uuid
  company           Company   @relation(fields: [companyId], references: [id])
  borrowerId        String    @unique @db.Uuid
  name              String
  sector            String?
  /// The borrower's role in the business, e.g. "Owner".
  borrowerRole      String?
  rdbNumber         String?
  registeredOn      DateTime? @db.Date
  avgMonthlyRevenue BigInt?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  borrower Borrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

enum KycDocumentType {
  NATIONAL_ID
  BUSINESS_REGISTRATION
  FINANCIAL_STATEMENTS
  PROOF_OF_ADDRESS
  SELFIE
  OTHER
}

model KycDocument {
  id           String          @id @default(uuid(7)) @db.Uuid
  companyId    String          @default(dbgenerated("current_company_id()")) @db.Uuid
  company      Company         @relation(fields: [companyId], references: [id])
  borrowerId   String          @db.Uuid
  type         KycDocumentType
  status       KycStatus       @default(PENDING)
  /// Object-storage key. The file itself never lives in the database.
  storageKey   String?
  /// Where verification came from, e.g. "NIDA".
  verifiedVia  String?
  note         String?
  uploadedAt   DateTime        @default(now())
  verifiedAt   DateTime?
  expiresOn    DateTime?       @db.Date
  verifiedById String?         @db.Uuid

  borrower   Borrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  verifiedBy User?    @relation(fields: [verifiedById], references: [id])

  @@index([borrowerId])
  @@index([companyId])
}

enum ConsentType {
  TERMS
  DATA_PROCESSING
  MOMO_HISTORY
  CREDIT_BUREAU
  MARKETING_SMS
}

enum ConsentChannel {
  APP
  OFFICER
  USSD
}

/// A record of explicit consent (Law Nº 058/2021). Rows are never deleted;
/// withdrawing consent sets revokedAt.
model Consent {
  id            String         @id @default(uuid(7)) @db.Uuid
  companyId     String         @default(dbgenerated("current_company_id()")) @db.Uuid
  company       Company        @relation(fields: [companyId], references: [id])
  borrowerId    String         @db.Uuid
  type          ConsentType
  /// Version of the wording the borrower agreed to.
  textVersion   String
  channel       ConsentChannel
  applicationId String?        @db.Uuid
  ip            String?
  grantedAt     DateTime       @default(now())
  revokedAt     DateTime?

  borrower    Borrower     @relation(fields: [borrowerId], references: [id])
  application Application? @relation(fields: [applicationId], references: [id])

  @@index([borrowerId, type])
  @@index([companyId])
}

// ───────────────────────── Products and applications ─────────────────────────

enum ProductKind {
  SME
  PERSONAL
  AGRI
  ASSET
}

model Product {
  id               String        @id @default(uuid(7)) @db.Uuid
  companyId        String        @default(dbgenerated("current_company_id()")) @db.Uuid
  company          Company       @relation(fields: [companyId], references: [id])
  code             String
  name             String
  /// Short name used on pipeline cards, e.g. "Agri input".
  shortName        String
  kind             ProductKind
  /// Default annual nominal rate in basis points (17% = 1700).
  annualRateBps    Int
  minTermMonths    Int
  maxTermMonths    Int
  minAmount        BigInt
  maxAmount        BigInt
  /// The loan engine's rules for this product (LoanTerms in @kora/core):
  /// interest method, frequency, fees, late charges, payment order and so on.
  /// `annualRateBps` mirrors its rate as a nominal annual figure.
  terms            Json
  /// Bumped on every change to `terms`; each version is kept in ProductVersion.
  version          Int           @default(1)
  /// Customers can apply, and staff can issue loans, only while published.
  /// Retired products keep their loans but take no new applications.
  status           ProductStatus @default(PUBLISHED)
  description      String?
  /// Instalments may be at most this share of verified income (35% = 3500).
  affordabilityBps Int           @default(3500)

  /// Auto-approve policy. Null means every application needs an officer.
  autoApproveMinScore  Int?
  autoApproveMaxAmount BigInt?
  /// Approvals above this amount need a second approver.
  secondApprovalAbove  BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
  loans        Loan[]
  offers       LoanOffer[]
  versions     ProductVersion[]

  @@unique([companyId, code])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

/// Every set of terms a product has had. Loans record the version they were issued under.
model ProductVersion {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @default(dbgenerated("current_company_id()")) @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id])
  productId   String   @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  version     Int
  terms       Json
  /// Product limits at the time, for the record.
  limits      Json
  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  @@unique([productId, version])
  @@index([companyId])
}

enum ApplicationStage {
  NEW
  UNDER_REVIEW
  CREDIT_CHECK
  APPROVED
  DISBURSED
  DECLINED
  WITHDRAWN
}

enum ApplicationChannel {
  CONSOLE
  APP
  USSD
}

model Application {
  id            String             @id @default(uuid(7)) @db.Uuid
  companyId     String             @default(dbgenerated("current_company_id()")) @db.Uuid
  company       Company            @relation(fields: [companyId], references: [id])
  /// Human reference, e.g. APP-20931.
  code          String
  borrowerId    String             @db.Uuid
  productId     String             @db.Uuid
  amount        BigInt
  termMonths    Int
  annualRateBps Int
  purpose       String?
  channel       ApplicationChannel @default(CONSOLE)

  stage               ApplicationStage @default(NEW)
  stageEnteredAt      DateTime         @default(now())
  /// Short status shown on the card, e.g. "Contract sent", "Awaiting CRB".
  statusNote          String?
  docsReceived        Int              @default(0)
  docsRequired        Int              @default(0)
  statedMonthlyIncome BigInt?
  /// Business details given in the app's apply flow.
  businessName        String?
  businessSector      String?

  officerId String? @db.Uuid
  branchId  String? @db.Uuid

  /// Credit decisions are made by a person (or the auto-approve policy), never by a model.
  decidedById      String?   @db.Uuid
  decidedAt        DateTime?
  autoApproved     Boolean   @default(false)
  declineReason    String?
  secondApproverId String?   @db.Uuid
  secondApprovedAt DateTime?

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  borrower       Borrower @relation(fields: [borrowerId], references: [id])
  product        Product  @relation(fields: [productId], references: [id])
  officer        User?    @relation("ApplicationOfficer", fields: [officerId], references: [id])
  decidedBy      User?    @relation("ApplicationDecider", fields: [decidedById], references: [id])
  secondApprover User?    @relation("ApplicationSecondApprover", fields: [secondApproverId], references: [id])
  branch         Branch?  @relation(fields: [branchId], references: [id])

  creditScores CreditScore[]
  consents     Consent[]
  loan         Loan?

  @@unique([companyId, code])
  @@index([stage])
  @@index([borrowerId])
  @@index([officerId])
}

/// Advisory only. There is deliberately no DECLINE value: a model can ask for
/// a review or raise a flag, but declining is a human decision.
enum ScoreRecommendation {
  AUTO_APPROVE_ELIGIBLE
  APPROVE
  REVIEW
  FLAG
}

/// A credit score or AI recommendation, stored with what it was based on.
model CreditScore {
  id                  String               @id @default(uuid(7)) @db.Uuid
  companyId           String               @default(dbgenerated("current_company_id()")) @db.Uuid
  company             Company              @relation(fields: [companyId], references: [id])
  borrowerId          String               @db.Uuid
  applicationId       String?              @db.Uuid
  /// 300–850.
  value               Int
  recommendation      ScoreRecommendation?
  /// One-line summary shown in the UI, e.g. "Flag · income mismatch".
  headline            String?
  /// Estimated chance of repayment in basis points (92% = 9200).
  repayProbabilityBps Int?
  /// A longer written summary, when a model produced one.
  summary             String?
  /// The reasons behind the score, as shown to the officer.
  reasons             Json
  /// The inputs the model saw, for audit and bias testing.
  inputs              Json
  modelVersion        String
  createdAt           DateTime             @default(now())

  /// Set when an officer decides against the recommendation.
  overriddenById String?   @db.Uuid
  overrideReason String?
  overriddenAt   DateTime?

  borrower     Borrower     @relation(fields: [borrowerId], references: [id])
  application  Application? @relation(fields: [applicationId], references: [id])
  overriddenBy User?        @relation(fields: [overriddenById], references: [id])

  @@index([borrowerId, createdAt])
  @@index([applicationId])
  @@index([companyId])
}

// ───────────────────────── Loans and schedules ─────────────────────────

enum LoanStatus {
  PENDING_DISBURSEMENT
  ACTIVE
  REPAID
  WRITTEN_OFF
}

model Loan {
  id                  String     @id @default(uuid(7)) @db.Uuid
  companyId           String     @default(dbgenerated("current_company_id()")) @db.Uuid
  company             Company    @relation(fields: [companyId], references: [id])
  /// Human reference, e.g. LN-0418-2026.
  code                String
  borrowerId          String     @db.Uuid
  applicationId       String?    @unique @db.Uuid
  productId           String     @db.Uuid
  principal           BigInt
  annualRateBps       Int
  termMonths          Int
  /// The level instalment from the schedule calculator in @kora/core.
  instalmentAmount    BigInt
  status              LoanStatus @default(PENDING_DISBURSEMENT)
  disbursedOn         DateTime?  @db.Date
  firstDueDate        DateTime   @db.Date
  maturityDate        DateTime   @db.Date
  closedOn            DateTime?  @db.Date
  /// What secures the loan, if anything, e.g. "Equipment lien".
  collateral          String?
  /// Bumped on each restructure. Instalments from older versions are kept for history.
  scheduleVersion     Int        @default(1)
  /// The product terms the loan was issued under (LoanTerms), copied so later
  /// product changes never alter it. Null for loans issued before products
  /// had terms: those follow legacyTerms() in @kora/core.
  terms               Json?
  productVersion      Int?
  /// Paid out to the borrower after fees taken at disbursement.
  netDisbursed        BigInt?
  /// The APR disclosed in the Key Facts Statement, basis points.
  aprBps              Int?
  /// Fees collected with instalments (VAT included), and how they split, so
  /// each collection posts to fee income, VAT payable or third parties exactly.
  spreadFeeTotal      BigInt     @default(0)
  spreadFeeVat        BigInt     @default(0)
  spreadFeeThirdParty BigInt     @default(0)
  officerId           String?    @db.Uuid
  branchId            String?    @db.Uuid
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // No balance columns here on purpose: outstanding principal and interest
  // are derived from LedgerEntry.

  borrower    Borrower     @relation(fields: [borrowerId], references: [id])
  application Application? @relation(fields: [applicationId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])
  officer     User?        @relation("LoanOfficer", fields: [officerId], references: [id])
  branch      Branch?      @relation(fields: [branchId], references: [id])

  instalments        ScheduleInstalment[]
  ledgerEntries      LedgerEntry[]
  ledgerTransactions LedgerTransaction[]
  payments           Payment[]
  disbursements      Disbursement[]
  restructures       Restructure[]
  collectionCases    CollectionCase[]
  contactLogs        ContactLog[]
  promises           PromiseToPay[]
  notes              Note[]
  smsMessages        SmsMessage[]

  @@unique([companyId, code])
  @@index([borrowerId])
  @@index([status])
  @@index([officerId])
}

enum InstalmentStatus {
  PENDING
  PARTIAL
  PAID
}

model ScheduleInstalment {
  id              String           @id @default(uuid(7)) @db.Uuid
  companyId       String           @default(dbgenerated("current_company_id()")) @db.Uuid
  company         Company          @relation(fields: [companyId], references: [id])
  loanId          String           @db.Uuid
  scheduleVersion Int              @default(1)
  number          Int
  dueDate         DateTime         @db.Date
  principalDue    BigInt
  interestDue     BigInt
  /// How much of this instalment has been covered. Written in the same
  /// database transaction as the ledger entries that paid it.
  principalPaid   BigInt           @default(0)
  interestPaid    BigInt           @default(0)
  /// Fees collected with this instalment (SPREAD fees, VAT included).
  feeDue          BigInt           @default(0)
  feePaid         BigInt           @default(0)
  /// Late charges added by the nightly run, and how far they have been counted.
  penaltyDue      BigInt           @default(0)
  penaltyPaid     BigInt           @default(0)
  penaltyThrough  DateTime?        @db.Date
  /// The day this instalment's interest period began. Null on older rows:
  /// the previous due date (or disbursement) is used.
  periodStart     DateTime?        @db.Date
  status          InstalmentStatus @default(PENDING)
  paidAt          DateTime?
  /// Set when a restructure replaces this instalment.
  supersededAt    DateTime?

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, scheduleVersion, number])
  @@index([dueDate, status])
  @@index([companyId])
}

// ───────────────────────── Double-entry ledger ─────────────────────────

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model LedgerAccount {
  id        String            @id @default(uuid(7)) @db.Uuid
  companyId String            @default(dbgenerated("current_company_id()")) @db.Uuid
  company   Company           @relation(fields: [companyId], references: [id])
  /// Chart-of-accounts code, e.g. "1100". Each company has its own chart.
  code      String
  name      String
  type      LedgerAccountType

  entries LedgerEntry[]

  @@unique([companyId, code])
}

enum LedgerTransactionType {
  OPENING_BALANCE
  DISBURSEMENT
  REPAYMENT
  FEE
  INTEREST_ACCRUAL
  PENALTY
  WRITE_OFF
  REVERSAL
  ADJUSTMENT
}

/// One business event. Its entries must sum to zero (debits = credits);
/// a deferred constraint trigger rejects the commit otherwise.
model LedgerTransaction {
  id             String                @id @default(uuid(7)) @db.Uuid
  companyId      String                @default(dbgenerated("current_company_id()")) @db.Uuid
  company        Company               @relation(fields: [companyId], references: [id])
  type           LedgerTransactionType
  /// Unique per business event, so a retried request cannot post twice.
  idempotencyKey String
  loanId         String?               @db.Uuid
  memo           String?
  /// The day the event counts for (Kigali calendar).
  effectiveOn    DateTime              @db.Date
  postedAt       DateTime              @default(now())
  postedById     String?               @db.Uuid
  /// For a REVERSAL: the transaction being undone. Entries are never edited.
  reversesId     String?               @unique @db.Uuid

  loan       Loan?              @relation(fields: [loanId], references: [id])
  postedBy   User?              @relation(fields: [postedById], references: [id])
  reverses   LedgerTransaction? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy LedgerTransaction? @relation("Reversal")

  entries      LedgerEntry[]
  payment      Payment?
  disbursement Disbursement?

  @@unique([companyId, idempotencyKey])
  @@index([loanId, effectiveOn])
}

enum EntryDirection {
  DEBIT
  CREDIT
}

/// One side of a transaction. Append-only: a trigger blocks UPDATE and DELETE.
model LedgerEntry {
  id            String         @id @default(uuid(7)) @db.Uuid
  companyId     String         @default(dbgenerated("current_company_id()")) @db.Uuid
  company       Company        @relation(fields: [companyId], references: [id])
  transactionId String         @db.Uuid
  accountId     String         @db.Uuid
  loanId        String?        @db.Uuid
  direction     EntryDirection
  /// Always positive. The direction says which side it sits on.
  amount        BigInt
  createdAt     DateTime       @default(now())

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])
  account     LedgerAccount     @relation(fields: [accountId], references: [id])
  loan        Loan?             @relation(fields: [loanId], references: [id])

  @@index([transactionId])
  @@index([accountId])
  @@index([loanId, accountId])
  @@index([companyId])
}

// ───────────────────────── Money movement ─────────────────────────

enum PaymentChannel {
  MTN_MOMO
  AIRTEL_MONEY
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REVERSED
}

/// A repayment. A callback that arrives twice hits the unique keys below
/// and is processed once.
model Payment {
  id                  String         @id @default(uuid(7)) @db.Uuid
  companyId           String         @default(dbgenerated("current_company_id()")) @db.Uuid
  company             Company        @relation(fields: [companyId], references: [id])
  loanId              String         @db.Uuid
  borrowerId          String         @db.Uuid
  amount              BigInt
  channel             PaymentChannel
  status              PaymentStatus  @default(PENDING)
  /// Our reference for the request (the MoMo X-Reference-Id).
  idempotencyKey      String
  /// The provider's transaction ID, once known.
  externalRef         String?
  payerPhone          String?
  failureReason       String?
  /// The provider callback as received, for reconciliation.
  rawCallback         Json?
  initiatedAt         DateTime       @default(now())
  confirmedAt         DateTime?
  recordedById        String?        @db.Uuid
  ledgerTransactionId String?        @unique @db.Uuid

  loan              Loan               @relation(fields: [loanId], references: [id])
  borrower          Borrower           @relation(fields: [borrowerId], references: [id])
  recordedBy        User?              @relation(fields: [recordedById], references: [id])
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id])

  @@unique([companyId, idempotencyKey])
  @@unique([companyId, channel, externalRef])
  @@index([loanId, confirmedAt])
  @@index([status])
}

enum DisbursementStatus {
  PENDING
  SENT
  SUCCESSFUL
  FAILED
}

model Disbursement {
  id                  String             @id @default(uuid(7)) @db.Uuid
  companyId           String             @default(dbgenerated("current_company_id()")) @db.Uuid
  company             Company            @relation(fields: [companyId], references: [id])
  loanId              String             @db.Uuid
  amount              BigInt
  channel             PaymentChannel
  status              DisbursementStatus @default(PENDING)
  idempotencyKey      String
  externalRef         String?
  payeePhone          String?
  failureReason       String?
  rawCallback         Json?
  initiatedAt         DateTime           @default(now())
  confirmedAt         DateTime?
  initiatedById       String?            @db.Uuid
  approvedById        String?            @db.Uuid
  ledgerTransactionId String?            @unique @db.Uuid

  loan              Loan               @relation(fields: [loanId], references: [id])
  initiatedBy       User?              @relation("DisbursementInitiator", fields: [initiatedById], references: [id])
  approvedBy        User?              @relation("DisbursementApprover", fields: [approvedById], references: [id])
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id])

  @@unique([companyId, idempotencyKey])
  @@unique([companyId, channel, externalRef])
  @@index([loanId])
}

enum RestructureType {
  EXTEND_TERM
  PAYMENT_HOLIDAY
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A change to a loan's terms. Always needs a second person to approve.
model Restructure {
  id                   String          @id @default(uuid(7)) @db.Uuid
  companyId            String          @default(dbgenerated("current_company_id()")) @db.Uuid
  company              Company         @relation(fields: [companyId], references: [id])
  loanId               String          @db.Uuid
  type                 RestructureType
  status               ApprovalStatus  @default(PENDING)
  reason               String?
  outstandingAtRequest BigInt
  previousInstalment   BigInt
  newInstalment        BigInt
  newTermMonths        Int
  capitalisedInterest  BigInt          @default(0)
  requestedById        String          @db.Uuid
  approvedById         String?         @db.Uuid
  requestedAt          DateTime        @default(now())
  decidedAt            DateTime?

  loan        Loan  @relation(fields: [loanId], references: [id])
  requestedBy User  @relation("RestructureRequester", fields: [requestedById], references: [id])
  approvedBy  User? @relation("RestructureApprover", fields: [approvedById], references: [id])

  @@index([loanId])
  @@index([status])
  @@index([companyId])
}

// ───────────────────────── Collections ─────────────────────────

enum CollectionCaseStatus {
  OPEN
  PROMISED
  RESOLVED
  WRITTEN_OFF
}

enum CollectionAction {
  SMS
  CALL
  FOLLOW_UP
  FIELD_VISIT
  WAIT
}

model CollectionCase {
  id           String               @id @default(uuid(7)) @db.Uuid
  companyId    String               @default(dbgenerated("current_company_id()")) @db.Uuid
  company      Company              @relation(fields: [companyId], references: [id])
  loanId       String               @db.Uuid
  status       CollectionCaseStatus @default(OPEN)
  nextAction   CollectionAction     @default(CALL)
  assignedToId String?              @db.Uuid
  dpdAtOpen    Int                  @default(0)
  /// When the next step is due: the promise date, or the day to call again.
  nextActionOn DateTime?            @db.Date
  openedAt     DateTime             @default(now())
  closedAt     DateTime?

  loan       Loan  @relation(fields: [loanId], references: [id])
  assignedTo User? @relation(fields: [assignedToId], references: [id])

  contactLogs ContactLog[]
  promises    PromiseToPay[]

  @@index([loanId])
  @@index([status, assignedToId])
  @@index([companyId])
}

enum ContactChannel {
  CALL
  SMS
  VISIT
  LETTER
  PAYMENT
}

enum ContactOutcome {
  SENT
  REACHED
  NO_ANSWER
  PROMISED_TO_PAY
  PAID_PART
  REFUSED
  WRONG_NUMBER
  DISPUTED
}

model ContactLog {
  id         String         @id @default(uuid(7)) @db.Uuid
  companyId  String         @default(dbgenerated("current_company_id()")) @db.Uuid
  company    Company        @relation(fields: [companyId], references: [id])
  caseId     String?        @db.Uuid
  loanId     String         @db.Uuid
  borrowerId String         @db.Uuid
  /// Null when the system did it (an automatic reminder, say).
  staffId    String?        @db.Uuid
  channel    ContactChannel
  outcome    ContactOutcome
  summary    String
  occurredAt DateTime       @default(now())

  case     CollectionCase? @relation(fields: [caseId], references: [id])
  loan     Loan            @relation(fields: [loanId], references: [id])
  borrower Borrower        @relation(fields: [borrowerId], references: [id])
  staff    User?           @relation(fields: [staffId], references: [id])

  @@index([loanId, occurredAt])
  @@index([companyId])
}

enum PromiseStatus {
  OPEN
  KEPT
  BROKEN
  CANCELLED
}

model PromiseToPay {
  id           String        @id @default(uuid(7)) @db.Uuid
  companyId    String        @default(dbgenerated("current_company_id()")) @db.Uuid
  company      Company       @relation(fields: [companyId], references: [id])
  caseId       String?       @db.Uuid
  loanId       String        @db.Uuid
  amount       BigInt
  promisedFor  DateTime      @db.Date
  status       PromiseStatus @default(OPEN)
  recordedById String?       @db.Uuid
  createdAt    DateTime      @default(now())

  case       CollectionCase? @relation(fields: [caseId], references: [id])
  loan       Loan            @relation(fields: [loanId], references: [id])
  recordedBy User?           @relation(fields: [recordedById], references: [id])

  @@index([loanId])
  @@index([promisedFor, status])
  @@index([companyId])
}

// ───────────────────────── Notes, notifications, SMS ─────────────────────────

model Note {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String   @default(dbgenerated("current_company_id()")) @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id])
  borrowerId String   @db.Uuid
  loanId     String?  @db.Uuid
  authorId   String   @db.Uuid
  body       String
  createdAt  DateTime @default(now())

  borrower Borrower @relation(fields: [borrowerId], references: [id])
  loan     Loan?    @relation(fields: [loanId], references: [id])
  author   User     @relation(fields: [authorId], references: [id])

  @@index([borrowerId, createdAt])
  @@index([companyId])
}

enum NotificationKind {
  AI_FLAG
  RISK
  CONTRACT
  PAYMENT
  SYSTEM
}

/// In-app notification for a staff member (userId) or a borrower (borrowerId).
/// A staff notification with no userId goes to everyone in the console.
model Notification {
  id         String           @id @default(uuid(7)) @db.Uuid
  companyId  String           @default(dbgenerated("current_company_id()")) @db.Uuid
  company    Company          @relation(fields: [companyId], references: [id])
  userId     String?          @db.Uuid
  borrowerId String?          @db.Uuid
  kind       NotificationKind
  title      String
  /// Where it links to inside the app, e.g. "/applications/APP-20914".
  href       String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user     User?     @relation(fields: [userId], references: [id])
  borrower Borrower? @relation(fields: [borrowerId], references: [id])

  @@index([userId, readAt])
  @@index([borrowerId, readAt])
  @@index([companyId])
}

enum SmsDirection {
  OUTBOUND
  INBOUND
}

enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model SmsMessage {
  id                String       @id @default(uuid(7)) @db.Uuid
  companyId         String       @default(dbgenerated("current_company_id()")) @db.Uuid
  company           Company      @relation(fields: [companyId], references: [id])
  borrowerId        String?      @db.Uuid
  loanId            String?      @db.Uuid
  toPhone           String
  body              String
  language          Language     @default(EN)
  direction         SmsDirection @default(OUTBOUND)
  status            SmsStatus    @default(QUEUED)
  /// Which template produced it, e.g. "reminder.due_soon". Null for free text.
  template          String?
  provider          String       @default("africastalking")
  providerMessageId String?      @unique
  failureReason     String?
  sentById          String?      @db.Uuid
  createdAt         DateTime     @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?

  borrower Borrower? @relation(fields: [borrowerId], references: [id])
  loan     Loan?     @relation(fields: [loanId], references: [id])
  sentBy   User?     @relation(fields: [sentById], references: [id])

  @@index([borrowerId, createdAt])
  @@index([status])
  @@index([companyId])
}

// ───────────────────────── Audit ─────────────────────────

enum ActorType {
  STAFF
  BORROWER
  SYSTEM
  /// An Orin Tech House platform admin (actorId is a PlatformAdmin id).
  PLATFORM
}

/// Who did what and when. Append-only: a trigger blocks UPDATE and DELETE.
model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  /// Null for platform-level events (company created, platform admin sign-in).
  companyId  String?   @default(dbgenerated("current_company_id()")) @db.Uuid
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actorType  ActorType @default(STAFF)
  actorId    String?   @db.Uuid
  /// Dotted verb, e.g. "auth.login", "loan.restructure.approve".
  action     String
  entityType String?
  entityId   String?
  /// Extra context. Must already be masked: no raw phone or ID numbers.
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  // actorId has no foreign key on purpose: an audit row must outlive whatever
  // it describes, and a cascading update would trip the append-only trigger.

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([companyId, createdAt])
}

// ───────────────────────── Reference numbers ─────────────────────────

/// Running numbers for human references (APP-20936, BR-01165, LN-0001-2027).
/// Incremented with a single atomic statement, so two requests never share one.
model CodeCounter {
  companyId String  @default(dbgenerated("current_company_id()")) @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])
  key       String
  value     Int

  @@id([companyId, key])
}

// ───────────────────────── Providers ─────────────────────────

/// A company's provider secrets: its MoMo and SMS keys, AI key, and the
/// credentials the app obtains for itself (the MoMo sandbox API user).
/// Values are encrypted like other secrets held in the database.
model ProviderCredential {
  companyId String   @default(dbgenerated("current_company_id()")) @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  key       String
  valueEnc  String
  updatedAt DateTime @updatedAt

  @@id([companyId, key])
}

/// State for the local MoMo simulator, used only when no MoMo keys are set.
model SimulatedTransfer {
  reference String   @id
  companyId String   @default(dbgenerated("current_company_id()")) @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  kind      String
  phone     String
  amount    BigInt
  createdAt DateTime @default(now())

  @@index([companyId])
}

/// One-time sign-in codes for borrowers. Only a hash of the code is stored.
model OtpChallenge {
  id         String    @id @default(uuid(7)) @db.Uuid
  companyId  String    @default(dbgenerated("current_company_id()")) @db.Uuid
  company    Company   @relation(fields: [companyId], references: [id])
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([companyId])
}

/// One-time codes texted to staff: second step of sign-in, or proving a phone
/// number. Separate from borrower codes, so one can never stand in for the other.
model StaffCode {
  id         String      @id @default(uuid(7)) @db.Uuid
  companyId  String      @default(dbgenerated("current_company_id()")) @db.Uuid
  company    Company     @relation(fields: [companyId], references: [id])
  subjectId  String      @db.Uuid
  user       User        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  purpose    CodePurpose
  phone      String
  codeHash   String
  attempts   Int         @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime    @default(now())

  @@index([subjectId, createdAt])
  @@index([companyId])
}

/// A borrower's sign-in session in the mobile app.
model BorrowerSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  companyId        String    @default(dbgenerated("current_company_id()")) @db.Uuid
  company          Company   @relation(fields: [companyId], references: [id])
  borrowerId       String    @db.Uuid
  refreshTokenHash String    @unique
  deviceName       String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  borrower Borrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)

  @@index([borrowerId])
  @@index([companyId])
}

/// A top-up or new-loan offer shown in the borrower app.
model LoanOffer {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @default(dbgenerated("current_company_id()")) @db.Uuid
  company     Company   @relation(fields: [companyId], references: [id])
  borrowerId  String    @db.Uuid
  productId   String    @db.Uuid
  maxAmount   BigInt
  termMonths  Int
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  expiresOn   DateTime  @db.Date
  acceptedAt  DateTime?
  dismissedAt DateTime?

  borrower Borrower @relation(fields: [borrowerId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([borrowerId])
  @@index([companyId])
}

/// Monthly money-in on a borrower's MoMo wallet, shared with their consent.
/// The scoring rules use it to judge how steady their income is.
model MomoInflowMonth {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String   @default(dbgenerated("current_company_id()")) @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id])
  borrowerId String   @db.Uuid
  month      DateTime @db.Date
  inflow     BigInt

  borrower Borrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)

  @@unique([borrowerId, month])
  @@index([companyId])
}

/// A question asked in "Ask your data", with the query that answered it.
model DataQuestion {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @default(dbgenerated("current_company_id()")) @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String   @db.Uuid
  question  String
  sql       String?
  rowCount  Int?
  error     String?
  model     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([companyId])
}

/// Text an AI model wrote for staff: a borrower summary, a collections
/// approach, an SMS draft. Always advisory, always stored with its inputs.
model AiNote {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String   @default(dbgenerated("current_company_id()")) @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id])
  kind       String
  borrowerId String?  @db.Uuid
  loanId     String?  @db.Uuid
  content    Json
  inputs     Json
  model      String
  createdAt  DateTime @default(now())

  @@index([kind, borrowerId, createdAt])
  @@index([kind, loanId, createdAt])
  @@index([companyId])
}

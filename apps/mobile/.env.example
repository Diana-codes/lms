# Where the API runs. On a real phone use your computer's LAN address,
# e.g. http://192.168.1.76:4000. The Android emulator reaches the host at 10.0.2.2.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Optional: a number borrowers can call from Support, e.g. +250 788 000 000
EXPO_PUBLIC_SUPPORT_PHONE=
